// The only place with colors, sizes and durations. Everything else derives from these values.
// Defaults match debug\Collecta\theme.ini; theme.rs overwrites them from the file while running.

export struct Palette {
    bg: color,
    surface: color,
    surface-hover: color,
    surface-active: color,
    border: color,
    text: color,
    text-muted: color,
    accent: color,
    danger: color,
    scrim: color,
}

export global Theme {
    in-out property <bool> dark: true;
    in property <Palette> dark-palette: {
        bg: #141416,
        surface: #1c1c1f,
        surface-hover: #26262a,
        surface-active: #313136,
        border: #2c2c31,
        text: #ececef,
        text-muted: #8e8e97,
        accent: #8fa8ff,
        danger: #f2777a,
        scrim: #000000b0,
    };
    in property <Palette> light-palette: {
        bg: #f5f5f7,
        surface: #ffffff,
        surface-hover: #ececef,
        surface-active: #e1e1e6,
        border: #dedee3,
        text: #1b1b1f,
        text-muted: #6b6b75,
        accent: #3b63d6,
        danger: #d03a3e,
        scrim: #00000073,
    };
    out property <Palette> color: dark ? dark-palette : light-palette;

    // Borders and separators, not configurable.
    out property <length> hairline: 1px;
    in property <length> unit: 4px;
    in property <length> radius: 10px;
    out property <length> radius-small: radius / 2;
    in property <length> control-height: 32px;
    out property <length> header-height: control-height + unit * 2;
    in property <length> icon-size: 16px;
    in property <length> font-size: 13px;
    out property <length> title-font-size: font-size * 1.75;
    in property <length> sidebar-width: 232px;
    in property <length> thumb-size: 180px;

    in property <duration> anim: 160ms;
    out property <duration> anim-long: anim * 2;
    in property <string> easing-name: "ease-out-quart";
}

// The easing named by Theme.easing-name. Slint can't hand an easing to Rust, so it lives apart from Theme
// (Theme is shared with Rust, this one isn't).
export global Motion {
    out property <easing> easing: Theme.easing-name == "linear" ? linear
        : Theme.easing-name == "ease" ? ease
        : Theme.easing-name == "ease-in" ? ease-in
        : Theme.easing-name == "ease-out" ? ease-out
        : Theme.easing-name == "ease-in-out" ? ease-in-out
        : Theme.easing-name == "ease-out-quad" ? ease-out-quad
        : Theme.easing-name == "ease-in-out-quad" ? ease-in-out-quad
        : Theme.easing-name == "ease-in-out-quart" ? ease-in-out-quart
        : Theme.easing-name == "ease-out-quint" ? ease-out-quint
        : Theme.easing-name == "ease-out-expo" ? ease-out-expo
        : Theme.easing-name == "ease-out-back" ? ease-out-back
        : Theme.easing-name == "ease-out-sine" ? ease-out-sine
        : Theme.easing-name == "ease-out-circ" ? ease-out-circ
        : ease-out-quart;
}
